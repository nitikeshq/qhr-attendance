PORT=5001
NODE_ENV=development
QHR_DATA_FILE=./data/dev-db.json

# Browser security. Native/mobile clients do not send an Origin header.
ALLOWED_ORIGINS=http://localhost:3002,http://localhost:3003,http://localhost:8082
TRUST_PROXY=false
MAX_JSON_BODY=10mb

# Session and abuse controls (milliseconds).
ACCESS_TOKEN_TTL_MS=86400000
REFRESH_TOKEN_TTL_MS=2592000000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
